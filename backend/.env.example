# Copy to .env and fill in your keys. Never commit the real .env.

# Google AI Studio key — https://aistudio.google.com/apikey (free tier works)
GEMINI_API_KEY=

# Alpha Vantage key — https://www.alphavantage.co/support/#api-key (free: 25 req/day)
ALPHA_VANTAGE_API_KEY=

# Optional: override the primary LLM. Defaults to gemini-2.5-flash (quality-first,
# 20 req/day free); automatic fallback to gemini-2.0-flash (~1,500 req/day) on quota.
# GEMINI_MODEL=gemini-2.0-flash
